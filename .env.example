# TeamTR Environment Configuration
# Copy this file to .env and update paths for your environment

# ============================================================================
# Required: Dataset and Model Paths
# ============================================================================

# Root directory containing all datasets
# Default: ./data (relative to project root)
TEAMTR_DATASETS_ROOT=/path/to/your/datasets

# Root directory containing all models
# Default: ./models (relative to project root)
TEAMTR_MODELS_ROOT=/path/to/your/models

# ============================================================================
# Training Configuration
# ============================================================================

# Training data files (comma-separated parquet files)
TEAMTR_TRAIN_FILES=${TEAMTR_DATASETS_ROOT}/train.parquet

# Validation data files
TEAMTR_VAL_FILES=${TEAMTR_DATASETS_ROOT}/val.parquet

# ============================================================================
# Model Paths
# ============================================================================

# Default model paths for different sizes
TEAMTR_MODEL_1P7B=${TEAMTR_MODELS_ROOT}/Qwen__Qwen3-1.7B
TEAMTR_MODEL_8B=${TEAMTR_MODELS_ROOT}/Qwen__Qwen3-8B
TEAMTR_MODEL_14B=${TEAMTR_MODELS_ROOT}/Qwen__Qwen3-14B

# ============================================================================
# Output and Logging
# ============================================================================

# Output directory for training runs
TEAMTR_OUTPUTS_DIR=./outputs

# Logs directory
TEAMTR_LOGS_DIR=./logs

# ============================================================================
# Environment Setup
# ============================================================================

# Micromamba/Conda prefix
MAMBA_ROOT_PREFIX=~/.micromamba

# Environment name
TEAMTR_ENV_NAME=TeamTR

# ============================================================================
# Optional: Cluster Configuration
# ============================================================================

# Maximum GPUs available on server (for pipeline script)
TEAMTR_GPU_LIMIT=16

# Training steps for quick tests
TEAMTR_TOTAL_TRAINING_STEPS=50

# ============================================================================
# Optional: Specific Evaluation Datasets
# ============================================================================

# Path to MATH500 evaluation dataset
TEAMTR_MATH500_PATH=${TEAMTR_DATASETS_ROOT}/math500/processed/val.parquet

# Path to AIME 2024 dataset
TEAMTR_AIME24_PATH=${TEAMTR_DATASETS_ROOT}/aime24/processed/val.parquet

# Path to AIME 2025 dataset
TEAMTR_AIME25_PATH=${TEAMTR_DATASETS_ROOT}/aime_2025/processed/val.parquet

# Path to ZebraLogic dataset
TEAMTR_ZEBRALOGIC_PATH=${TEAMTR_DATASETS_ROOT}/ZebraLogic_grid_mode/processed/val.parquet
